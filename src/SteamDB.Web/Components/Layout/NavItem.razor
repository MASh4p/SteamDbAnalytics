@if (Mini)
{
    <MudTooltip Text="@Text" Placement="Placement.Right" Arrow="true">
        <MudNavLink Href="@Href" Match="@Match" Icon="@Icon">@Text</MudNavLink>
    </MudTooltip>
}
else
{
    <MudNavLink Href="@Href" Match="@Match" Icon="@Icon">@Text</MudNavLink>
}

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public bool Mini { get; set; }
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
}
